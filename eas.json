{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "development",
        "ACHARYA_UPDATE_CHANNEL": "development",
        "EXPO_NO_DOTENV": "1"
      },
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "preview",
        "ACHARYA_UPDATE_CHANNEL": "preview",
        "EXPO_NO_DOTENV": "1"
      },
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "ACHARYA_UPDATE_CHANNEL": "production",
        "EXPO_NO_DOTENV": "1"
      },
      "channel": "production",
      "environment": "production"
    },
    "staging": {
      "extends": "production",
      "channel": "staging",
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ACHARYA_UPDATE_CHANNEL": "staging"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
