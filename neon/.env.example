# Neon Functions deployment settings — server only, never EXPO_PUBLIC_.
# Copy this file to neon/.env and fill in the values you need.
# neon/.env is ignored by Git. Do not paste private values into chat.

# Production API (neon/neon.ts): matching production Clerk secret and
# restricted acharya_login database URL, never a migration/admin connection.
ACHARYA_RELEASE_CLERK_SECRET_KEY=
ACHARYA_RUNTIME_DATABASE_URL=

# Testing API (neon/community-testing.ts): matching development Clerk secret
# and the isolated testing database's restricted acharya_login URL.
ACHARYA_COMMUNITY_CLERK_SECRET_KEY=
ACHARYA_COMMUNITY_CLERK_ISSUER=https://resolved-quetzal-37.clerk.accounts.dev
ACHARYA_COMMUNITY_AUTHORIZED_PARTIES=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
ACHARYA_COMMUNITY_DATABASE_URL=

# ImageKit dashboard -> API keys -> private key and URL endpoint.
# The backend uploads photos; no ImageKit public key is needed in the app.
ACHARYA_IMAGEKIT_PRIVATE_KEY=
ACHARYA_IMAGEKIT_URL_ENDPOINT=

# Comma-separated Clerk user IDs allowed to review community reports.
ACHARYA_COMMUNITY_MODERATOR_IDS=
# Random secret of at least 32 characters, also configured on the cleanup scheduler.
ACHARYA_COMMUNITY_CLEANUP_SECRET=
# Assigned when creating the Neon scheduled cleanup trigger for this environment.
ACHARYA_COMMUNITY_NEON_TRIGGER_ID=

# Optional existing Google credential backup; Clerk manages actual sign-in.
ACHARYA_GOOGLE_OAUTH_CLIENT_ID=
ACHARYA_GOOGLE_OAUTH_CLIENT_SECRET=
