  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "db:migrate:pg": "drizzle-kit migrate --config drizzle.config.pg.ts",
    "db:generate:expo": "drizzle-kit generate --config drizzle.config.expo.ts",
    "check": "npm run typecheck && npm run lint && npm test && expo export --platform all --clear",
    "postinstall": "node node_modules/llama.rn/install/download-native-artifacts.js && patch-package --error-on-fail",
    "native:gate:prepare": "node scripts/native-gate/prepare.cjs",
    "test:rag": "vitest run --config vitest.rag.config.ts",
    "rag:status": "node scripts/rag-status.cjs"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sqlite"
        ]
      }
    }
  }
