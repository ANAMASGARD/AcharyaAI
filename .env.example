# =============================================================================
# Acharya — environment variables
# =============================================================================
# 1. Copy: cp .env.example .env
# 2. Paste Clerk keys from https://dashboard.clerk.com/~/api-keys
# 3. Restart Metro: npx expo start --clear
#
# Never commit .env — it is gitignored.
# =============================================================================

# --- Client (Expo) — EXPO_PUBLIC_ prefix only ---

# Required — publishable key from Clerk Dashboard → API keys
# Local dev / Expo Go: pk_test_… (Clerk may log a “development keys” notice — expected)
# Play Store / EAS production: pk_live_… via EAS Secrets (see README)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional — Account Portal URL for browser account settings fallback
# EXPO_PUBLIC_CLERK_ACCOUNT_PORTAL_URL=

# --- Server — never prefix with EXPO_PUBLIC_ ---

# Required for API routes — secret key (sk_test_ or sk_live_)
CLERK_SECRET_KEY=

# Neon PostgreSQL — server / API routes only (never EXPO_PUBLIC_)
DATABASE_URL=

# Legacy development-only API origin (not used by report cloud sync)
# EXPO_PUBLIC_API_URL=https://your-app.expo.app

# -----------------------------------------------------------------------------
# Clerk Dashboard checklist (Play Store / production auth)
# -----------------------------------------------------------------------------
#
# 1. Native API enabled:
#    https://dashboard.clerk.com/~/native-applications
# 2. Add Android app: package name com.acharya.app
# 3. Add iOS app: bundle ID com.acharya.app (when shipping iOS)
# 4. Enable email verification code (passwordless OTP) for sign-in and sign-up
# 5. Email OTP works with the custom app screens; native magic links need Clerk native UI.
# 6. User settings → allow users to delete their accounts (deleteSelfEnabled)
# 7. Enable Google only after custom production OAuth credentials/callback tests pass.
#
# Do NOT put CLERK_SECRET_KEY in EXPO_PUBLIC_ variables.
# -----------------------------------------------------------------------------

# Gnani speech-to-text — server only, never EXPO_PUBLIC_
GNANI_API_KEY=

# Current mobile backend: Neon Functions, never a Vercel/Next.js origin.
# Public URL only; setting this does not opt the account into synchronization.
# Expo Go and test APKs must use the testing API with their pk_test_ Clerk key.
# Production APKs use the production API with pk_live_. See docs/community-environments.md.
EXPO_PUBLIC_NEON_FUNCTION_URL=
# Development: set true after enabling Google in the matching Clerk dev instance.
# Production: keep false until custom Google credentials and callback tests pass.
# Expo Go shows a disabled Google button; use a development or installed build.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Enable only after Facebook is configured in the matching Clerk instance.
EXPO_PUBLIC_FACEBOOK_AUTH_ENABLED=false
# Enable only after Microsoft callback, email verification, and native tests pass.
EXPO_PUBLIC_MICROSOFT_AUTH_ENABLED=false
EXPO_PUBLIC_APP_VARIANT=development

# Legacy server routes / Neon Function authentication: server-only values.
APP_ENV=development
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
# Production deployment uses neon/neon.ts and a restricted private env file.
# Do not place its secrets in this Expo file for release builds.

# Community media — server only. Configure on the Neon Function, not the device.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
COMMUNITY_MODERATOR_IDS=
# Random scheduler-only secret, at least 32 characters. Never share with app users.
COMMUNITY_CLEANUP_SECRET=
# Deployment maps ACHARYA_IMAGEKIT_PRIVATE_KEY / ACHARYA_IMAGEKIT_URL_ENDPOINT /
# ACHARYA_COMMUNITY_MODERATOR_IDS / ACHARYA_COMMUNITY_CLEANUP_SECRET into these.
# To fill deployment values yourself, use neon/.env (template: neon/.env.example)
# and pass --env neon/.env to neon deploy. This root file is for Expo/local routes;
# filling its IMAGEKIT_* values alone does not update the hosted Neon Function.

# Curriculum library / uploads / verification / chat (Expo API routes, server-only).
# Reuse the existing acharya_rag schema; do not run public-schema migrations for RAG.
# RAG_* overrides allow a separate deployment without changing the community backend.
OPENAI_API_KEY=
RAG_DATABASE_URL=
RAG_OPENAI_API_KEY=
RAG_CLERK_SECRET_KEY=
RAG_CLERK_ISSUER=
RAG_CLERK_AUTHORIZED_PARTIES=
RAG_APP_ENV=development
OPENAI_REASONING_MODEL=gpt-5-mini
# Public URL only, never a key. Must use the same Clerk instance as the mobile app.
# Local development can omit this and use Metro's API routes.
EXPO_PUBLIC_RAG_API_URL=

# Live conversation only. Server-side; never EXPO_PUBLIC_.
# Falls back to RAG_OPENAI_API_KEY / OPENAI_API_KEY when omitted.
VOICE_OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-realtime-2
